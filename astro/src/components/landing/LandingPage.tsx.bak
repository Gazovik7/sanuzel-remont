function LandingPage({ pathname }: { pathname?: string }) {
  return (
    <ModalProvider>
      <div className="font-sans text-[#09090b] bg-white selection:bg-[#D4AF37] selection:text-white">
        <Header pathname={pathname} />
        
        <main>
           <Hero />
           <CasesResults />
           <LeadMagnetBlock />
           <GrowthBlock />
           <ServicesIncluded />
           <WheelOfBalance />
           <MethodologyComparison />
