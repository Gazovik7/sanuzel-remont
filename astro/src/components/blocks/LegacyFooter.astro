---
const isSpb = Astro.url.pathname.startsWith('/spb');
const prefix = isSpb ? '/spb' : '';
const addressText = isSpb ? 'г. Санкт-Петербург' : 'г. Москва, Большой Саввинский пер., 9С1';
const phoneTel = isSpb ? '+78122448556' : '+74951375239';
const phoneDisplay = isSpb ? '8 (812) 244-85-56' : '8 (495) 137-52-39';
const currentYear = new Date().getFullYear();
const copyrightText = isSpb ? `Ремонт санузлов в Санкт-Петербурге c 2018-${currentYear}` : `Ремонт санузлов в Москве c 2018-${currentYear}`;
const crossLinkHref = isSpb ? '/' : '/spb/';
const crossLinkText = isSpb ? 'Ремонт ванных комнат в Москве и области' : 'Ремонт ванных комнат в СПб и Ленобласти';
---

<footer class="bg-slate-950 text-white py-16 border-t border-slate-900 mt-auto">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <div class="space-y-8">
        <div class="flex flex-col items-start">
          <img
            src="/img/logo.png"
            alt="Ремонт Санузлов"
            class="h-16 w-auto object-contain brightness-0 invert mb-4"
          />
          <div class="font-heading font-bold text-xl tracking-wider uppercase mb-6">
            Ремонт Санузлов
          </div>
          <p class="text-sm text-gray-400 mb-4">
            Помогаем получить ванную комнату мечты более 7 лет!
          </p>
          <a href={crossLinkHref} class="text-sm text-blue-400 hover:text-blue-300 transition-colors">
            {crossLinkText} &rarr;
          </a>
        </div>
      </div>
      <div>
        <h3 class="font-heading font-bold text-2xl mb-6">Компания</h3>
        <ul class="space-y-4 text-gray-400">
          <li>
            <a href={`${prefix}/about-us/`} class="hover:text-white transition-colors"
              >О нас</a
            >
          </li>
          <li>
            <a href={`${prefix}/portfolio/`} class="hover:text-white transition-colors"
              >Портфолио</a
            >
          </li>
          <li>
            <a href={`${prefix}/otzyvy-klientov/`} class="hover:text-white transition-colors"
              >Отзывы</a
            >
          </li>
          <li>
            <a href="/blog/" class="hover:text-white transition-colors">Блог</a>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="font-heading font-bold text-2xl mb-6">Услуги</h3>
        <ul class="space-y-4 text-gray-400">
          <li>
            <a href={`${prefix}/`} class="hover:text-white transition-colors"
              >Ремонт ванной</a
            >
          </li>
          <li>
            <a
              href={`${prefix}/byudzhetnyy-remont-v-vannoy-komnate/`}
              class="hover:text-white transition-colors"
              >Бюджетный ремонт</a
            >
          </li>
          <li>
            <a
              href={`${prefix}/prajs-list-na-remont-sanuzlov/`}
              class="hover:text-white transition-colors"
              >Прайс-лист</a
            >
          </li>
          <li>
            <a href={`${prefix}/contacts/`} class="hover:text-white transition-colors"
              >Контакты</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h3 class="font-heading font-bold text-2xl mb-6">Контакты</h3>
        <div class="space-y-6">
          <a
            href={`tel:${phoneTel}`}
            class="block text-2xl font-bold hover:text-blue-400 transition-colors"
            >{phoneDisplay}</a
          >
          <div class="flex items-start gap-3 text-sm text-gray-400">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-map-pin w-5 h-5 text-blue-600 shrink-0"
            >
              <path
                d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"
              ></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{addressText}</span>
          </div>
          <div class="flex items-start gap-3 text-sm text-gray-400">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-clock w-5 h-5 text-blue-600 shrink-0"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div>
              <div>Режим работы:</div>
              <div>пн-вс: 09.00-20.00</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="border-t border-slate-900 pt-8 text-xs text-gray-500 space-y-4">
      <div
        class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4"
      >
        <div>{copyrightText}</div>
        <div class="flex gap-6"><span>Все права защищены</span></div>
      </div>
      <p class="max-w-4xl opacity-60 leading-relaxed">
        Сайт носит информационный характер и не является публичной офертой.
        Информация на сайте носит ознакомительный характер и не является
        публичной офертой, определяемой положениями статьи 437 Гражданского
        кодекса РФ.
      </p>
      <div
        class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 pt-4 border-t border-slate-900 mt-4"
      >
        <a
          href="https://smirnov.marketing/"
          target="_blank"
          rel="noopener"
          class="hover:text-white text-[10px]"
          >Создание и продвижение сайта Smirnov.Marketing</a
        >
      </div>
      <div class="pt-2 text-[10px] text-gray-600 flex flex-wrap gap-4">
        <a
          href="/docs/consent_to_the_processing_of_personal_data.docx"
          class="hover:text-white"
          >Согласие на обработку персональных данных</a
        ><a href="/docs/cookie_policy.docx" class="hover:text-white"
          >Политика обработки файлов Cookies</a
        ><a href="/docs/privacy_policy.docx" class="hover:text-white"
          >Политика конфиденциальности персональных данных</a
        >
      </div>
    </div>
  </div>
</footer>
