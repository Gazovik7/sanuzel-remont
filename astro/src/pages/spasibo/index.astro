---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegacyHeaderSolid from '../../components/blocks/LegacyHeaderSolid.astro';
import LegacyFooter from '../../components/blocks/LegacyFooter.astro';
import LegacyMobileStickyBar from '../../components/blocks/LegacyMobileStickyBar.astro';
import LegacyScrollTopButton from '../../components/blocks/LegacyScrollTopButton.astro';
import { Check } from 'lucide-react';

const title = 'Спасибо за заявку!';
const description = 'Ваша заявка принята. Наш менеджер свяжется с вами в ближайшее время.';
---

<BaseLayout title={title} description={description} canonicalPath="/spasibo/">
  <div id="top" class="min-h-screen bg-white text-slate-900 font-sans selection:bg-blue-100 selection:text-blue-900 flex flex-col">
    <LegacyHeaderSolid />

    <main class="flex-1 pt-20 lg:pt-24">
      <section class="py-24 lg:py-32 bg-gradient-to-br from-slate-50 via-white to-blue-50">
        <div class="container mx-auto px-4 max-w-3xl">
          <div class="text-center">
            <!-- Success Icon -->
            <div class="w-24 h-24 lg:w-32 lg:h-32 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-8 ring-8 ring-green-50/50 shadow-xl">
              <svg class="w-12 h-12 lg:w-16 lg:h-16 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>

            <!-- Title -->
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-extrabold mb-6 text-slate-900">
              Заявка принята!
            </h1>

            <!-- Description -->
            <p class="text-xl lg:text-2xl text-gray-600 mb-12 leading-relaxed max-w-2xl mx-auto">
              Наш менеджер свяжется с вами выбранным способом в течение 15 минут.
            </p>

            <!-- Benefits -->
            <div class="bg-white rounded-3xl p-8 lg:p-12 shadow-2xl border border-gray-100 mb-12">
              <h2 class="text-2xl lg:text-3xl font-heading font-bold mb-8 text-slate-900">
                Что дальше?
              </h2>

              <div class="space-y-6 text-left">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0 mt-1">
                    <span class="text-blue-600 font-bold text-lg">1</span>
                  </div>
                  <div>
                    <h3 class="font-bold text-lg text-slate-900 mb-1">Консультация специалиста</h3>
                    <p class="text-gray-600">
                      Менеджер ответит на все ваши вопросы и подберёт оптимальное решение для вашего санузла.
                    </p>
                  </div>
                </div>

                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0 mt-1">
                    <span class="text-blue-600 font-bold text-lg">2</span>
                  </div>
                  <div>
                    <h3 class="font-bold text-lg text-slate-900 mb-1">Бесплатный замер</h3>
                    <p class="text-gray-600">
                      Наш инженер выедет на объект, произведёт замеры и рассчитает точную стоимость работ.
                    </p>
                  </div>
                </div>

                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0 mt-1">
                    <span class="text-blue-600 font-bold text-lg">3</span>
                  </div>
                  <div>
                    <h3 class="font-bold text-lg text-slate-900 mb-1">Подписание договора</h3>
                    <p class="text-gray-600">
                      Заключим официальный договор с фиксированной ценой и гарантией на все работы.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- CTA Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a
                href="/"
                class="inline-block py-4 px-8 bg-slate-900 text-white rounded-xl font-bold hover:bg-slate-800 transition-all transform hover:-translate-y-0.5 shadow-lg"
              >
                На главную
              </a>
              <a
                href="/contacts/"
                class="inline-block py-4 px-8 bg-white border-2 border-slate-200 text-slate-900 rounded-xl font-bold hover:border-slate-300 hover:bg-slate-50 transition-all"
              >
                Контакты
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <LegacyFooter />
    <LegacyMobileStickyBar />
    <LegacyScrollTopButton />
  </div>
</BaseLayout>
