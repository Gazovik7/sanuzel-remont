---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactsModern from '../../components/landing/ContactsModern';

const seo = {
  title: "Контакты | Smirnov Marketing - SEO агентство в Москве",
  description: "Свяжитесь с нами для обсуждения вашего проекта. Телефон, почта, адрес офиса в Москве и форма обратной связи.",
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath="/contacts/"
>
  <ContactsModern pathname={Astro.url.pathname} client:load />
</BaseLayout>
