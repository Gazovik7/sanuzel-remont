---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LegacyHeaderSolid from '../../../components/blocks/LegacyHeaderSolid.astro';
import LegacyContactsSection from '../../../components/blocks/LegacyContactsSection.astro';
import LegacyFooter from '../../../components/blocks/LegacyFooter.astro';
import LegacyMobileStickyBar from '../../../components/blocks/LegacyMobileStickyBar.astro';
import LegacyScrollTopButton from '../../../components/blocks/LegacyScrollTopButton.astro';

import { ReviewsPage } from '../../../legacy/components/ReviewsPage';

const title = 'Отзывы клиентов о ремонте санузлов в Санкт-Петербурге';
const description =
  'Реальные отзывы клиентов о ремонте санузлов в Санкт-Петербурге: благодарности, фото, опыт и впечатления.';
---

<BaseLayout title={title} description={description} canonicalPath="/spb/otzyvy-klientov/">
  <div id="top" class="min-h-screen bg-white text-slate-900 font-sans selection:bg-blue-100 selection:text-blue-900 flex flex-col">
    <LegacyHeaderSolid />
    <main class="flex-1 pt-20 lg:pt-24">
      <ReviewsPage
        onNavigate={() => {}}
        onCalculate={() => {}}
        breadcrumbItems={[
          { label: 'Санкт-Петербург', href: '/spb/' },
          { label: 'Отзывы', isActive: true },
        ]}
      />
    </main>
    <LegacyContactsSection />
    <LegacyFooter />
    <LegacyMobileStickyBar />
    <LegacyScrollTopButton />
  </div>
</BaseLayout>
