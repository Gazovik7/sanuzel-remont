---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="404 — Авария на линии! | Ремонт санузлов"
  description="Страница не найдена, зато мы нашли протечку! Помогите устранить аварию."
>
  <section class="min-h-[80vh] flex flex-col items-center justify-center bg-slate-50 px-4 py-10 relative overflow-hidden selection:bg-blue-200">
    
    <!-- Game UI Container -->
    <div class="relative z-20 w-full max-w-3xl">
      
      <!-- Header -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 bg-red-100 text-red-600 px-4 py-1 rounded-full font-bold text-sm mb-4 animate-pulse">
          <span class="w-2 h-2 bg-red-500 rounded-full"></span>
          КОД ОШИБКИ: 404 (ПРОРЫВ)
        </div>
        <h1 class="text-4xl md:text-5xl font-black text-slate-900 mb-2">
          Страница утекла...
        </h1>
        <p class="text-slate-500 text-lg">
          Пока мы ищем страницу, помогите нам <span class="text-blue-600 font-bold">закрутить гайки!</span>
        </p>
      </div>

      <!-- Game Board -->
      <div class="bg-white rounded-3xl shadow-2xl shadow-blue-900/10 border-4 border-slate-200 p-2 md:p-6 relative overflow-hidden">
        
        <!-- Score & Stats -->
        <div class="flex justify-between items-center mb-6 px-2">
          <div class="flex flex-col">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Бюджет спасен</span>
            <span class="text-2xl md:text-3xl font-black text-green-600 font-mono" id="score">0 ₽</span>
          </div>
          <div class="flex flex-col text-right">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Статус мастера</span>
            <span class="text-sm md:text-base font-bold text-blue-600" id="rank">Стажер</span>
          </div>
        </div>

        <!-- The Grid -->
        <div class="grid grid-cols-3 md:grid-cols-4 gap-2 md:gap-4 aspect-[4/3] md:aspect-[2/1] bg-slate-100 rounded-xl border border-slate-200 relative" id="game-grid">
          <!-- Game Overlay (Start Screen) -->
          <div id="start-screen" class="absolute inset-0 z-30 bg-white/90 backdrop-blur-sm flex flex-col items-center justify-center p-6 text-center transition-opacity duration-300">
            <div class="text-6xl mb-4">🧰</div>
            <h3 class="text-2xl font-bold text-slate-800 mb-2">Готовы к работе?</h3>
            <p class="text-slate-500 mb-6 max-w-sm">Кликайте по протечкам, чтобы устранить их и заработать виртуальные рубли.</p>
            <button id="start-btn" class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold text-lg shadow-lg shadow-blue-300 transform hover:scale-105 transition-all">
              Начать смену
            </button>
          </div>

          <!-- Tiles (Generated by JS) -->
        </div>

        <!-- Progress Bar -->
        <div class="mt-4 h-2 bg-slate-100 rounded-full overflow-hidden">
          <div id="time-bar" class="h-full bg-blue-500 w-full transition-all duration-1000 ease-linear"></div>
        </div>

      </div>

      <!-- Navigation Buttons -->
      <div class="flex justify-center gap-4 mt-10">
        <a href="/" class="text-slate-600 font-medium hover:text-blue-600 underline decoration-2 underline-offset-4 transition-colors">
          Вернуться на главную
        </a>
        <span class="text-slate-300">|</span>
        <a href="/contacts/" class="text-slate-600 font-medium hover:text-blue-600 underline decoration-2 underline-offset-4 transition-colors">
          Вызвать настоящего мастера
        </a>
      </div>

    </div>

    <!-- Background Elements -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
      <div class="absolute top-1/4 left-10 text-9xl opacity-5 rotate-12">🚽</div>
      <div class="absolute bottom-1/4 right-10 text-9xl opacity-5 -rotate-12">🛁</div>
    </div>

  </section>
</BaseLayout>

<script>
  // Game Logic
  const grid = document.getElementById('game-grid');
  const startScreen = document.getElementById('start-screen');
  const startBtn = document.getElementById('start-btn');
  const scoreEl = document.getElementById('score');
  const rankEl = document.getElementById('rank');
  const timeBar = document.getElementById('time-bar');

  let score = 0;
  let gameActive = false;
  let activeLeaks = [];
  let gameLoop;
  let timeLeft = 30; // seconds
  const totalTime = 30;

  const GRID_SIZE = 12; // 3x4 or 4x3 depending on mobile
  
  // Initialize Grid
  function initGrid() {
    // Clear overlay but keep it in DOM structure if needed, or just clear children
    // We only want to clear the TILES, not the start screen overlay
    const existingTiles = grid.querySelectorAll('.tile');
    existingTiles.forEach(t => t.remove());

    for (let i = 0; i < GRID_SIZE; i++) {
      const tile = document.createElement('div');
      tile.className = 'tile bg-white rounded-lg shadow-sm border border-slate-200 flex items-center justify-center text-4xl cursor-pointer relative overflow-hidden transition-colors duration-200 hover:bg-slate-50 select-none';
      tile.dataset.index = i.toString();
      
      // Pipe Background (Visual only)
      const pipe = document.createElement('div');
      pipe.className = 'absolute inset-0 opacity-10 bg-[url("/img/pipe-pattern.svg")] bg-center bg-no-repeat bg-contain'; 
      // Fallback if svg missing: simple CSS pipe
      pipe.innerHTML = `<div class="w-full h-2 bg-slate-400 absolute top-1/2 -translate-y-1/2"></div>`;
      
      tile.appendChild(pipe);
      
      // Click Handler
      tile.addEventListener('click', (e) => fixLeak(e, tile));
      tile.addEventListener('touchstart', (e) => { e.preventDefault(); fixLeak(e, tile); }); // Better mobile response

      grid.appendChild(tile);
    }
  }

  function startGame() {
    score = 0;
    timeLeft = totalTime;
    gameActive = true;
    activeLeaks = [];
    updateUI();
    initGrid();
    
    startScreen.style.opacity = '0';
    setTimeout(() => startScreen.style.display = 'none', 300);

    // Main Loop
    gameLoop = setInterval(() => {
      if (!gameActive) return;

      timeLeft--;
      timeBar.style.width = `${(timeLeft / totalTime) * 100}%`;

      // Spawn leaks more frequently as time goes on
      if (Math.random() > 0.3) {
        spawnLeak();
      }

      if (timeLeft <= 0) {
        endGame();
      }
    }, 1000);
  }

  function spawnLeak() {
    const tiles = document.querySelectorAll('.tile');
    const availableTiles = Array.from(tiles).filter(t => !t.classList.contains('leaking'));
    
    if (availableTiles.length === 0) return;

    const randomTile = availableTiles[Math.floor(Math.random() * availableTiles.length)];
    randomTile.classList.add('leaking');
    
    // Add water emoji animation
    const water = document.createElement('div');
    water.className = 'water-spray absolute inset-0 flex items-center justify-center text-4xl animate-bounce';
    water.textContent = '💦';
    randomTile.appendChild(water);
  }

  function fixLeak(e, tile) {
    if (!gameActive || !tile.classList.contains('leaking')) return;

    // Visual Feedback
    tile.classList.remove('leaking');
    tile.querySelector('.water-spray')?.remove();
    
    // Success Animation
    const fix = document.createElement('div');
    fix.className = 'absolute inset-0 flex items-center justify-center text-4xl animate-ping opacity-75';
    fix.textContent = '🔧'; // Wrench
    tile.appendChild(fix);
    
    setTimeout(() => fix.remove(), 500);

    // Score Logic
    score += 500;
    updateUI();

    // Sound effect (simulated visual) -> Trigger vibration on mobile
    if (navigator.vibrate) navigator.vibrate(50);
  }

  function updateUI() {
    scoreEl.textContent = `${score} ₽`;
    
    let rank = 'Стажер';
    if (score > 2000) rank = 'Помощник';
    if (score > 5000) rank = 'Мастер';
    if (score > 10000) rank = 'Прораб';
    if (score > 15000) rank = 'Бог Сантехники';
    
    rankEl.textContent = rank;
    
    // Rank Color
    if (score > 10000) {
        rankEl.className = 'text-sm md:text-base font-bold text-amber-500';
    } else {
        rankEl.className = 'text-sm md:text-base font-bold text-blue-600';
    }
  }

  function endGame() {
    gameActive = false;
    clearInterval(gameLoop);
    
    startScreen.style.display = 'flex';
    // Small delay to allow display flex to apply before opacity
    setTimeout(() => startScreen.style.opacity = '1', 10);
    
    const title = startScreen.querySelector('h3');
    const desc = startScreen.querySelector('p');
    const btn = startScreen.querySelector('button');

    title.textContent = 'Смена окончена!';
    desc.innerHTML = `Вы сэкономили <strong>${score} ₽</strong>.<br>Ваш ранг: <strong>${rankEl.textContent}</strong>.`;
    btn.textContent = 'Сыграть еще раз';
  }

  // Initialization
  startBtn.addEventListener('click', startGame);
  
  // Initial setup visual (without starting logic)
  initGrid();

</script>

<style>
  .leaking {
    background-color: #e0f2fe !important; /* blue-100 */
    border-color: #60a5fa !important; /* blue-400 */
  }
</style>