---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutModern from '../../components/landing/AboutModern';

const seo = {
  title: 'О компании Smirnov Marketing | Экспертное SEO агентство в Москве',
  description: 'Узнайте больше о нашей команде, принципах работы и подходе к масштабированию бизнеса через поисковый маркетинг.',
};
---

<BaseLayout title={seo.title} description={seo.description} canonicalPath="/about-us/">
  <AboutModern pathname={Astro.url.pathname} client:load />
</BaseLayout>
