---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogModern from '../../components/landing/BlogModern';

const seo = {
  title: 'Блог Smirnov Marketing | Тренды и стратегии SEO продвижения',
  description: 'Полезные статьи, кейсы и новости из мира поискового маркетинга. Узнайте, как масштабировать ваш бизнес в 2025 году.',
};
---

<BaseLayout title={seo.title} description={seo.description} canonicalPath="/blog/">
  <BlogModern pathname={Astro.url.pathname} client:load />
</BaseLayout>
