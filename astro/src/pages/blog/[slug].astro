---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegacyHeaderSolid from '../../components/blocks/LegacyHeaderSolid.astro';
import LegacyContactsSection from '../../components/blocks/LegacyContactsSection.astro';
import LegacyFooter from '../../components/blocks/LegacyFooter.astro';
import LegacyMobileStickyBar from '../../components/blocks/LegacyMobileStickyBar.astro';
import LegacyScrollTopButton from '../../components/blocks/LegacyScrollTopButton.astro';

import { ArticlePage } from '../../legacy/components/ArticlePage';
import { BLOG_POSTS } from '../../data/blog';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = BLOG_POSTS.find((p) => p.slug === slug);

const title = post ? `${post.title} | Блог` : 'Блог';
const description = post?.description
  ? post.description
  : post?.excerpt
  ? post.excerpt
  : 'Блог о ремонте санузлов: статьи, советы мастеров, технологии и материалы.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={post ? `/blog/${post.slug}/` : `/blog/${slug}/`}
>
  <div id="top" class="min-h-screen bg-white text-slate-900 font-sans selection:bg-blue-100 selection:text-blue-900 flex flex-col">
    <LegacyHeaderSolid />
    <main class="flex-1 pt-20 lg:pt-24">
      {post ? (
        <ArticlePage id={post.id} onNavigate={() => {}} onCalculate={() => {}} />
      ) : (
        <div class="container mx-auto px-4 py-16 max-w-4xl">
          <h1 class="text-3xl font-heading font-extrabold">Post not found</h1>
        </div>
      )}
    </main>
    <LegacyContactsSection />
    <LegacyFooter />
    <LegacyMobileStickyBar />
    <LegacyScrollTopButton />
  </div>
</BaseLayout>
