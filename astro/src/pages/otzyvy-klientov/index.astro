---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewsModern from '../../components/landing/ReviewsModern';

const seo = {
  title: 'Отзывы клиентов Smirnov Marketing | Реальные результаты и рекомендации',
  description: 'Читайте отзывы наших партнеров о результатах SEO продвижения и контекстной рекламы. Видео-интервью и кейсы Smirnov Marketing.',
};
---

<BaseLayout title={seo.title} description={seo.description} canonicalPath="/otzyvy-klientov/">
  <ReviewsModern pathname={Astro.url.pathname} client:load />
</BaseLayout>
