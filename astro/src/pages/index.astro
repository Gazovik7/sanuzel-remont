---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingPage from '../components/landing/LandingPage';
import { HOME_PAGE_DATA } from '../data/pages/home';
---

<BaseLayout
  title={HOME_PAGE_DATA.seo.title}
  description={HOME_PAGE_DATA.seo.description}
>
  <LandingPage data={HOME_PAGE_DATA} pathname={Astro.url.pathname} client:load />
</BaseLayout>