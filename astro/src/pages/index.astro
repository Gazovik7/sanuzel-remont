---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingPage from '../components/landing/LandingPage';

const seo = {
  title: "SEO продвижение сайтов в Москве | Smirnov Marketing",
  description: "Комплексное SEO продвижение сайтов в Москве. Вывод в ТОП-3 Яндекс и Google с финансовыми гарантиями. Закажите бесплатный аудит!",
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
>
  <LandingPage pathname={Astro.url.pathname} client:load />
</BaseLayout>
