---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleModern from '../../components/landing/ArticleModern';
import { BLOG_POSTS } from '../../components/landing/constants';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { id: String(post.id) },
  }));
}

const { id } = Astro.params;
const post = BLOG_POSTS.find((p) => String(p.id) === String(id));
const pathname = Astro.url.pathname;

const title = post ? `${post.title} | Smirnov Marketing` : 'Статья не найдена';
const description = post ? post.excerpt : 'Полезные статьи о SEO и маркетинге от Smirnov Marketing';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={post ? `/article/${post.id}/` : `/article/${id}/`}
>
  {post ? (
    <ArticleModern post={post} pathname={pathname} client:load />
  ) : (
    <div class="min-h-screen bg-[#09090b] flex items-center justify-center text-white">
        <div class="text-center">
            <h1 class="text-4xl font-bold mb-4">404</h1>
            <p class="text-gray-400 mb-8">Статья не найдена</p>
            <a href="/blog/" class="text-[#D4AF37] hover:underline">Вернуться в блог</a>
        </div>
    </div>
  )}
</BaseLayout>