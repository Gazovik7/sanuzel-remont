---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioModern from '../../components/landing/PortfolioModern';

const seo = {
  title: 'Портфолио Smirnov Marketing | Кейсы по SEO и результативному маркетингу',
  description: 'Примеры наших работ и реальные результаты клиентов. Посмотрите, как мы увеличиваем трафик и прибыль бизнеса.',
};
---

<BaseLayout title={seo.title} description={seo.description} canonicalPath="/portfolio/">
  <PortfolioModern pathname={Astro.url.pathname} client:load />
</BaseLayout>
