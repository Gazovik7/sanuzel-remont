---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegacyHeaderLanding from '../../components/blocks/LegacyHeaderLanding.astro';
import LegacyContactsSection from '../../components/blocks/LegacyContactsSection.astro';
import LegacyFooter from '../../components/blocks/LegacyFooter.astro';
import LegacyMobileStickyBar from '../../components/blocks/LegacyMobileStickyBar.astro';
import LegacyScrollTopButton from '../../components/blocks/LegacyScrollTopButton.astro';

import LegacyHero from '../../components/islands/legacy/LegacyHero';
import LegacyPortfolioSection from '../../components/islands/legacy/LegacyPortfolioSection';
import LegacyCalculator from '../../components/islands/legacy/LegacyCalculator';
import LegacyReviewsSection from '../../components/islands/legacy/LegacyReviewsSection';
import LegacyFaqSection from '../../components/islands/legacy/LegacyFaqSection';
import LegacyGeographySection from '../../components/islands/legacy/LegacyGeographySection';

import {
  ComparisonSection,
  QualityControlSection,
  WhyUsSection,
  MaterialsSection,
  PackagesSection,
  WorkflowSection,
  IncludedSection,
  VisualizationSection,
  TeamSection,
  GuaranteeSection,
  SeoTextSection,
} from '../../legacy/components/ContentSections';
import { Breadcrumbs } from '../../legacy/components/Breadcrumbs';
import { getService, type ServiceBlock } from '../../data/services';

const service = getService('demontazhnye-raboty');

const blockByType = <T extends ServiceBlock['type']>(type: T) =>
  service.blocks.find((item): item is Extract<ServiceBlock, { type: T }> => item.type === type);

const heroBlock = blockByType('hero');
const breadcrumbBlock = blockByType('breadcrumb');
const comparisonBlock = blockByType('comparison');
const portfolioBlock = blockByType('portfolio');
const qualityBlock = blockByType('quality');
const whyUsBlock = blockByType('whyUs');
const materialsBlock = blockByType('materials');
const calculatorBlock = blockByType('calculator');
const packagesBlock = blockByType('packages');
const workflowBlock = blockByType('workflow');
const includedBlock = blockByType('included');
const visualizationBlock = blockByType('visualization');
const teamBlock = blockByType('team');
const guaranteeBlock = blockByType('guarantee');
const reviewsBlock = blockByType('reviews');
const seoTextBlock = blockByType('seoText');
const faqBlock = blockByType('faq');
const geographyBlock = blockByType('geography');

const title = service.seo.title;
const description = service.seo.description;
---

<BaseLayout title={title} description={description} canonicalPath={service.canonicalPath}>
  <div id="top" class="min-h-screen bg-white text-slate-900 font-sans selection:bg-blue-100 selection:text-blue-900 flex flex-col">
    <LegacyHeaderLanding />

    <main class="flex-1">
      {heroBlock && <LegacyHero client:load config={heroBlock.config} />}

      {breadcrumbBlock && (
        <div class="bg-white">
          <div class="container mx-auto px-4">
            <Breadcrumbs items={breadcrumbBlock.items} />
          </div>
        </div>
      )}

      {comparisonBlock && (
        <div id="comparison" class="reveal bg-white">
          <ComparisonSection onAction={() => {}} content={comparisonBlock.config} />
        </div>
      )}

      {portfolioBlock && (
        <div id="portfolio" class="reveal bg-slate-100">
          <LegacyPortfolioSection client:load content={portfolioBlock.config} items={portfolioBlock.items} />
        </div>
      )}

      {qualityBlock && (
        <div id="quality" class="reveal bg-white">
          <QualityControlSection content={qualityBlock.config} checklist={qualityBlock.checklist} />
        </div>
      )}

      {whyUsBlock && (
        <div id="why-us" class="reveal bg-slate-100">
          <WhyUsSection content={whyUsBlock.config} />
        </div>
      )}

      {materialsBlock && (
        <div class="reveal bg-white">
          <MaterialsSection content={materialsBlock.config} brands={materialsBlock.brands} />
        </div>
      )}

      {calculatorBlock && (
        <div id="calculator-section" class="reveal bg-slate-100">
          <section class="py-24">
            <div class="container mx-auto px-4 text-center mb-16">
              <span class="text-blue-600 font-bold tracking-wider uppercase text-xs mb-3 block">{calculatorBlock.config.sectionKicker}</span>
              <h2 class="text-3xl md:text-5xl font-heading font-extrabold mb-6 text-slate-900">{calculatorBlock.config.sectionTitle}</h2>
              <p class="text-gray-500 max-w-2xl mx-auto text-lg">{calculatorBlock.config.sectionDescription}</p>
            </div>
            <div class="container mx-auto px-4">
              <LegacyCalculator client:load config={calculatorBlock.config} />
            </div>
          </section>
        </div>
      )}

      {packagesBlock && (
        <div id="packages" class="reveal bg-white">
          <PackagesSection onSelect={() => {}} packages={packagesBlock.packages} content={packagesBlock.config} />
        </div>
      )}

      {workflowBlock && (
        <div class="reveal">
          <WorkflowSection content={workflowBlock.config} steps={workflowBlock.steps} />
        </div>
      )}

      {includedBlock && (
        <div class="reveal bg-white">
          <IncludedSection content={includedBlock.config} works={includedBlock.works} />
        </div>
      )}

      {visualizationBlock && (
        <div class="reveal bg-slate-100">
          <VisualizationSection content={visualizationBlock.config} />
        </div>
      )}

      {teamBlock && (
        <div class="reveal bg-white">
          <TeamSection content={teamBlock.config} members={teamBlock.members} />
        </div>
      )}

      {guaranteeBlock && (
        <div class="reveal bg-slate-100">
          <GuaranteeSection content={guaranteeBlock.config} />
        </div>
      )}

      {reviewsBlock && (
        <div id="reviews" class="reveal bg-white">
          <LegacyReviewsSection
            client:load
            content={reviewsBlock.config}
            videoReviews={reviewsBlock.videoReviews}
            whatsappReviews={reviewsBlock.whatsappReviews}
            paperReviews={reviewsBlock.paperReviews}
          />
        </div>
      )}

      {seoTextBlock && (
        <div class="reveal bg-white">
          <SeoTextSection content={seoTextBlock.config} />
        </div>
      )}

      {faqBlock && (
        <div id="faq" class="reveal bg-slate-100">
          <LegacyFaqSection client:load content={faqBlock.config} items={faqBlock.items} />
        </div>
      )}

      {geographyBlock && (
        <div id="geography" class="reveal bg-white">
          <LegacyGeographySection client:load content={geographyBlock.config} />
        </div>
      )}
    </main>

    <LegacyContactsSection />
    <LegacyFooter />
    <LegacyMobileStickyBar />
    <LegacyScrollTopButton />
  </div>
</BaseLayout>
