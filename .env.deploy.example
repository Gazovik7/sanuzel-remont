# FTP Configuration for deployment
# Copy this file to .env.deploy and fill in your actual credentials

# FTP server hostname or IP address
FTP_HOST=ftp.your-hosting.com

# FTP username
FTP_USER=your-ftp-username

# FTP password
FTP_PASS=your-ftp-password

# Destination directory on FTP server (usually /public_html/ or /www/)
FTP_DEST=/public_html/

# Optional: FTP port (default is 21)
# FTP_PORT=21

# Optional: Use secure FTP (FTPS)
# FTP_SECURE=false
