{
  "name": "sanuzel-remont",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix astro run dev",
    "build": "npm --prefix astro run build && node scripts/strip-nulls.mjs",
    "preview": "npm --prefix astro run preview",
    "check": "npm --prefix astro run check",
    "check:indexability": "node scripts/check-indexability.mjs",
    "check:blocks": "node scripts/check-blocks.mjs",
    "check:all": "node scripts/check-indexability.mjs && node scripts/check-blocks.mjs",
    "build:production": "npm run build && npm run check:all",
    "postinstall": "npm --prefix astro install",
    "deploy": "npm run build:production && node scripts/deploy-ftp.mjs",
    "deploy:watch": "node scripts/deploy-watch.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "images:webp": "node scripts/generate-webp.mjs"
  },
  "devDependencies": {
    "basic-ftp": "^5.0.5",
    "imagemin": "^9.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "sharp": "^0.33.5"
  }
}
