/**
 * ШАБЛОН МИНИМАЛЬНОЙ СТРАНИЦЫ
 *
 * Скопируйте этот файл в astro/src/data/services/pages/your-page-slug.ts
 * и заполните своим контентом.
 *
 * После создания не забудьте:
 * 1. Добавить импорт в astro/src/data/services/pages/index.ts
 * 2. Добавить в PAGES реестр
 * 3. Создать роут: astro/src/pages/your-page-slug/index.astro
 */

import { buildBlocks, unique, use, off } from '../builder';
import type { ServicePage } from '../types';

// ========================================
// КОНСТАНТЫ СТРАНИЦЫ
// ========================================

// SEO текст (большой блок контента для поисковиков)
const SEO_TEXT_BLOCK_CONTENT = {
  title: 'О услуге подробнее',
  expandButtonText: 'Читать полностью',
  collapseButtonText: 'Свернуть',
  content: `
    <h2>Заголовок раздела</h2>
    <p>Параграф с описанием услуги. Здесь можно использовать HTML разметку.</p>

    <h3>Подзаголовок</h3>
    <p>Ещё один параграф. Можно добавить <strong>важные слова</strong> и <em>акценты</em>.</p>

    <ul>
      <li>Пункт списка 1</li>
      <li>Пункт списка 2</li>
      <li>Пункт списка 3</li>
    </ul>
  `,
};

// FAQ (часто задаваемые вопросы)
const FAQ_ITEMS = [
  {
    question: 'Первый вопрос?',
    answer: 'Ответ на первый вопрос. Можно использовать HTML.',
  },
  {
    question: 'Второй вопрос?',
    answer: 'Ответ на второй вопрос.',
  },
  {
    question: 'Третий вопрос?',
    answer: 'Ответ на третий вопрос.',
  },
];

// Что входит в услугу
const INCLUDED_WORKS = [
  'Работа 1 (например: Демонтаж старой плитки)',
  'Работа 2 (например: Выравнивание стен)',
  'Работа 3 (например: Укладка новой плитки)',
  'Работа 4 (например: Установка сантехники)',
  'Работа 5 (например: Финальная уборка)',
];

const INCLUDED_BLOCK_CONTENT = {
  title: 'Что входит в стоимость',
  description: 'Полный список работ, которые входят в базовый пакет услуги.',
  ctaText: 'Получить точную смету',
};

// ========================================
// ЭКСПОРТ СТРАНИЦЫ
// ========================================

export const page: ServicePage = {
  // URL страницы: /your-page-slug/
  slug: 'your-page-slug',
  path: '/your-page-slug/', // ВАЖНО: слеш в конце обязателен!

  // SEO meta-теги
  seo: {
    title: 'Заголовок страницы для поисковиков | Название сайта',
    description: 'Описание страницы для поисковиков (meta description). Рекомендуемая длина: 120-160 символов.',
  },

  // Блоки контента (секции на странице)
  blocks: buildBlocks([

    // ========================================
    // HERO - Главный экран
    // ========================================
    unique({
      type: 'hero',
      variant: 'default',
      config: {
        badgeText: 'Популярная услуга', // Бейдж сверху (опционально)
        titleHighlight: 'Название услуги',
        subtitle: 'Краткое описание услуги в 1-2 предложения',

        // Подзаголовки (можно несколько строк)
        subtitleLines: [
          'Преимущество 1',
          'Преимущество 2',
          'Преимущество 3',
        ],

        // Основное изображение
        image: '/img/hero/your-service-hero.jpg',
        imageAlt: 'Описание изображения для alt',

        // CTA кнопки
        ctaPrimaryText: 'Заказать услугу',
        ctaSecondaryText: 'Рассчитать стоимость',

        // Оффер/предложения (опционально, можно удалить)
        offers: [
          { text: 'Бесплатный выезд мастера' },
          { text: 'Гарантия 3 года' },
          { text: 'Работаем без предоплаты' },
        ],
      },
    }),

    // ========================================
    // СРАВНЕНИЕ - Мы vs конкуренты (переиспользуемый блок)
    // ========================================
    use('comparison'),
    // Этот блок настраивается глобально в shared/blocks.ts

    // ========================================
    // ПОРТФОЛИО - Фото "до" и "после" (переиспользуемый блок)
    // ========================================
    use('portfolioDefault'),
    // Настраивается в shared/datasets.ts (PORTFOLIO_ITEMS)

    // ========================================
    // ЧТО ВХОДИТ - Список работ
    // ========================================
    unique({
      ...use('included'), // Наследуем базовую структуру
      config: INCLUDED_BLOCK_CONTENT,
      works: INCLUDED_WORKS,
    }),

    // ========================================
    // ПАКЕТЫ/ТАРИФЫ (переиспользуемый блок)
    // ========================================
    use('packages'),
    // Настраивается в shared/datasets.ts (PACKAGES)

    // ========================================
    // ПРОЦЕСС РАБОТЫ (переиспользуемый блок)
    // ========================================
    use('workflow'),

    // ========================================
    // КОМАНДА (переиспользуемый блок)
    // ========================================
    use('team'),
    // Настраивается в shared/datasets.ts (TEAM_MEMBERS)

    // ========================================
    // ГАРАНТИЯ (переиспользуемый блок)
    // ========================================
    use('guarantee'),

    // ========================================
    // ОТЗЫВЫ (переиспользуемый блок)
    // ========================================
    use('reviews'),
    // Настраивается в shared/datasets.ts (REVIEWS)

    // ========================================
    // SEO ТЕКСТ - Большой блок контента
    // ========================================
    unique({
      type: 'seoText',
      config: SEO_TEXT_BLOCK_CONTENT,
    }),

    // ========================================
    // FAQ - Часто задаваемые вопросы
    // ========================================
    unique({
      type: 'faq',
      variant: 'default',
      config: {
        title: 'Часто задаваемые вопросы',
        description: 'Ответы на популярные вопросы о наших услугах',
      },
      items: FAQ_ITEMS,
    }),

    // ========================================
    // ГЕОГРАФИЯ (переиспользуемый блок)
    // ========================================
    use('geography'),

    // ========================================
    // ПРИМЕРЫ ОТКЛЮЧЕНИЯ БЛОКОВ
    // ========================================
    // Если какой-то блок не нужен на этой странице:
    // off(), // вместо use('какой-то-блок')

    // Или просто не добавляйте блок в массив
  ]),
};

/**
 * ДОСТУПНЫЕ БЛОКИ (можно использовать через use()):
 *
 * - 'comparison' - Сравнение с конкурентами
 * - 'portfolioDefault' - Портфолио (до/после)
 * - 'quality' - Контроль качества (чеклист)
 * - 'whyUs' - Почему мы
 * - 'materials' - Материалы
 * - 'packages' - Пакеты/тарифы
 * - 'workflow' - Процесс работы
 * - 'included' - Что входит
 * - 'visualization' - Визуализация
 * - 'team' - Команда
 * - 'guarantee' - Гарантия
 * - 'reviews' - Отзывы
 * - 'geography' - География работ
 *
 * Полный список в astro/src/data/services/shared/blocks.ts
 */

/**
 * ТИПЫ УНИКАЛЬНЫХ БЛОКОВ (можно создать через unique()):
 *
 * - hero - Главный экран
 * - seoText - SEO текст
 * - faq - FAQ
 * - calculator - Калькулятор стоимости
 *
 * Полные интерфейсы в astro/src/data/services/types.ts
 */

/**
 * СЛЕДУЮЩИЕ ШАГИ:
 *
 * 1. Скопируйте этот файл:
 *    cp TEMPLATE-PAGE.ts.example astro/src/data/services/pages/your-page-slug.ts
 *
 * 2. Замените 'your-page-slug' на реальный slug
 *
 * 3. Заполните контент (SEO, блоки)
 *
 * 4. Добавьте импорт в astro/src/data/services/pages/index.ts:
 *    import { page as yourPage } from './your-page-slug';
 *
 * 5. Добавьте в PAGES реестр:
 *    export const PAGES = {
 *      home,
 *      'your-page-slug': yourPage,
 *    };
 *
 * 6. Создайте роут astro/src/pages/your-page-slug/index.astro:
 *    ---
 *    import ServicePageTemplate from '../../components/pages/ServicePageTemplate.astro';
 *    ---
 *    <ServicePageTemplate slug="your-page-slug" />
 *
 * 7. Запустите dev сервер и проверьте:
 *    cd astro && npm run dev
 *    Откройте: http://localhost:4321/your-page-slug/
 */
